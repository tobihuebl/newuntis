{
  "extends": "@sp/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "src"
  ]
}
