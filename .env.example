# Lokale Entwicklung (docker compose up). Geheimnisse nie einchecken.
DATABASE_URL=postgresql://sp:sp@localhost:5432/schulplattform
SESSION_SECRET=change-me-in-dev-only-32-chars-min!!
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMTP_URL=smtp://localhost:1025
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=schulplattform
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key-123
DEFAULT_TIMEZONE=Europe/Vienna
# Laufzeit-Rolle der API (unterliegt Row-Level-Security); DATABASE_URL ist der Eigentümer für Migrationen und Seed
DATABASE_APP_URL=postgresql://sp_app:sp_app@localhost:5432/schulplattform
# Schule wird aus der Subdomain bestimmt: demo.localhost -> Schule "demo"
BASE_DOMAIN=localhost
# 32 Byte, base64. Verschlüsselt TOTP-Geheimnisse auf Anwendungsebene. Nur dieser Entwicklungswert ist unkritisch.
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
