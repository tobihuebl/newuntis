{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_APP_URL",
    "BASE_DOMAIN",
    "ENCRYPTION_KEY",
    "SESSION_SECRET",
    "APP_URL",
    "API_URL",
    "VAPID_*",
    "SMTP_URL",
    "S3_*",
    "DEFAULT_TIMEZONE",
    "TEST_*"
  ]
}
