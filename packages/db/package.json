{
  "name": "@sp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy && tsx scripts/setup-app-role.ts",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "prebuild": "prisma generate",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup-app-role": "tsx scripts/setup-app-role.ts",
    "tenant:create": "tsx scripts/tenant-create.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@sp/config": "workspace:*",
    "@sp/shared": "workspace:*",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
