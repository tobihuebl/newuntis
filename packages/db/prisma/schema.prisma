// Verbindliche Feldliste: docs/spec.md Abschnitte 8 und 10.
// Jede Tabelle außer Tenant hat tenantId (Row-Level-Security, siehe Migration "enable_rls").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  GUARDIAN
  TEACHER
  HOMEROOM
  PRINCIPAL
  ADMIN
}

enum PersonKind {
  STUDENT
  TEACHER
  GUARDIAN
  STAFF
}

enum WeekPattern {
  EVERY
  A
  B
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
  SUBSTITUTED
  ROOM_CHANGED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum AbsenceStatus {
  OPEN // aus dem Klassenbuch, Entschuldigung ausständig (Ergänzung zur Spec, ADR 0008)
  REPORTED
  EXCUSED
  REJECTED
  UNEXCUSED
}

enum AbsenceOrigin {
  CLASSBOOK // Lehrkraft hat "abwesend" eingetragen
  REPORT // Meldung durch Eltern, Schüler:in oder Administration
}

enum TeacherAbsenceKind {
  SICK
  TRAINING
  LEAVE
  OTHER
}

enum SubstitutionKind {
  SUBSTITUTE
  CANCEL
  ROOM_CHANGE
  SUPERVISION
}

enum SessionStage {
  ACTIVE
  NEEDS_2FA_VERIFY // Passwort geprüft, TOTP-Code fehlt noch
  NEEDS_2FA_SETUP // Rolle verlangt 2FA, TOTP ist noch nicht eingerichtet
}

enum SubstitutionStatus {
  OPEN
  ASSIGNED
  PUBLISHED
}

// ───────────────────────── Mandant, Personen, Rechte ─────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Vienna")
  settings  Json     @default("{}") // Fristen, Grenzwerte, Altersgrenzen
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Person {
  id              String     @id @default(cuid())
  tenantId        String
  kind            PersonKind
  firstName       String
  lastName        String
  birthDate       DateTime?  @db.Date
  externalId      String? // z. B. Schülernummer aus CSV
  email           String? // Kontakt- und Einladungsadresse (Konto-E-Mail steht in User)
  anonymizedAt    DateTime?  @db.Timestamptz(3)
  restrictedAt    DateTime?  @db.Timestamptz(3) // Einschränkung der Verarbeitung (DSGVO Art. 18): keine Nachrichten, Rundschreiben, Benachrichtigungen
  employmentHours Float? // Lehrkräfte: Beschäftigungsausmaß in Wochenstunden laut Vertrag
  teachingHours   Float? // Lehrkräfte: davon Unterricht (Soll-Unterrichtsstunden je Woche)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  user                    User?
  roles                   RoleAssignment[]
  guardianLinks           GuardianLink[]           @relation("LinkGuardian")
  studentLinks            GuardianLink[]           @relation("LinkStudent")
  homeroomClasses         SchoolClass[]            @relation("Homeroom")
  enrollments             Enrollment[]
  groupMemberships        GroupMember[]
  lessonTeachers          LessonTeacher[]
  teacherSubjects         TeacherSubject[]
  remarksAbout            ClassbookRemark[]        @relation("RemarkStudent")
  remarksWritten          ClassbookRemark[]        @relation("RemarkAuthor")
  absenceWarnings         AbsenceWarning[]
  grades                  Grade[]
  promotions              PromotionDecision[]
  requirements            LessonRequirement[]
  attendances             Attendance[]
  absences                Absence[]
  teacherAbsences         TeacherAbsence[]
  substitutions           Substitution[]
  occurrenceTeachers      OccurrenceTeacher[]
  threadParticipations    ThreadParticipant[]
  announcementReads       AnnouncementRead[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  calendarTokens          CalendarToken[]
  invitations             Invitation[]
  guardianCodes           GuardianCode[]
  messages                Message[]
  threadsAbout            Thread[]                 @relation("ThreadAbout")
  announcements           Announcement[]
  consents                Consent[]
  privacyRequests         PrivacyRequest[]         @relation("PrivacySubject")
  planningConstraints     PlanningConstraint[]

  @@unique([tenantId, externalId])
  @@index([tenantId, kind])
  @@index([tenantId, email])
  @@index([tenantId, lastName, firstName])
}

model User {
  id               String    @id @default(cuid())
  tenantId         String
  personId         String    @unique
  email            String
  passwordHash     String?
  totpSecret       String? // verschlüsselt gespeichert
  totpEnabled      Boolean   @default(false)
  totpLastCounter  Int? // zuletzt benutzte TOTP-Zeitscheibe: Schutz gegen Wiederverwendung eines Codes
  lastLoginAt      DateTime? @db.Timestamptz(3)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3) // temporäre Sperre nach wiederholten Fehlversuchen
  onboardedAt      DateTime? @db.Timestamptz(3) // Einführung nach dem ersten Login abgeschlossen
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  person        Person               @relation(fields: [personId], references: [id])
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  resetTokens   PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RoleAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  personId  String
  role      Role
  classId   String? // nur bei HOMEROOM (Klassenvorstand)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  person Person       @relation(fields: [personId], references: [id])
  class  SchoolClass? @relation(fields: [classId], references: [id])

  @@index([tenantId, personId])
  @@index([tenantId, classId])
}

model GuardianLink {
  id         String    @id @default(cuid())
  tenantId   String
  guardianId String // Person
  studentId  String // Person
  canExcuse  Boolean   @default(true)
  validFrom  DateTime  @db.Date
  validTo    DateTime? @db.Date
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  guardian Person @relation("LinkGuardian", fields: [guardianId], references: [id])
  student  Person @relation("LinkStudent", fields: [studentId], references: [id])

  @@index([tenantId, guardianId])
  @@index([tenantId, studentId])
}

// ───────────────────────── Stammdaten ─────────────────────────

model SchoolYear {
  id        String   @id @default(cuid())
  tenantId  String
  name      String // "2026/27"
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  freeDays            SchoolFreeDay[]
  classes             SchoolClass[]
  groups              Group[]
  timetables          TimetableVersion[]
  planningConstraints PlanningConstraint[]
  planningRuns        PlanningRun[]
  absenceWarnings     AbsenceWarning[]
  gradeWeightings     GradeWeighting[]
  assessments         Assessment[]
  promotionDecisions  PromotionDecision[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
}

model SchoolFreeDay {
  id           String   @id @default(cuid())
  tenantId     String
  schoolYearId String
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  label        String // Ferien, Feiertag, schulautonom frei
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  @@index([tenantId, fromDate, toDate])
}

model SchoolClass {
  id                String   @id @default(cuid())
  tenantId          String
  schoolYearId      String
  name              String // "3A"
  homeroomTeacherId String? // Person
  previousClassId   String? // Vorgängerklasse im vorigen Schuljahr (Schuljahreswechsel, SD-05)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  schoolYear          SchoolYear           @relation(fields: [schoolYearId], references: [id])
  homeroomTeacher     Person?              @relation("Homeroom", fields: [homeroomTeacherId], references: [id])
  previousClass       SchoolClass?         @relation("ClassSuccession", fields: [previousClassId], references: [id], onDelete: SetNull)
  successors          SchoolClass[]        @relation("ClassSuccession")
  enrollments         Enrollment[]
  roleAssignments     RoleAssignment[]
  lessons             Lesson[]
  requirements        LessonRequirement[]
  occurrences         Occurrence[]
  exams               Exam[]
  planningConstraints PlanningConstraint[]

  assessments     Assessment[]
  gradeWeightings GradeWeighting[]

  @@unique([tenantId, schoolYearId, name])
  @@index([tenantId, schoolYearId])
}

model Enrollment {
  id        String    @id @default(cuid())
  tenantId  String
  studentId String
  classId   String
  fromDate  DateTime  @db.Date
  toDate    DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  student Person      @relation(fields: [studentId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id])

  @@index([tenantId, classId])
  @@index([tenantId, studentId])
}

model Group {
  id           String   @id @default(cuid())
  tenantId     String
  schoolYearId String
  name         String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  schoolYear   SchoolYear          @relation(fields: [schoolYearId], references: [id])
  members      GroupMember[]
  lessons      Lesson[]
  requirements LessonRequirement[]
  occurrences  Occurrence[]
  exams        Exam[]

  assessments     Assessment[]
  gradeWeightings GradeWeighting[]

  @@index([tenantId, schoolYearId])
}

model GroupMember {
  id        String   @id @default(cuid())
  tenantId  String
  groupId   String
  studentId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  group   Group  @relation(fields: [groupId], references: [id])
  student Person @relation(fields: [studentId], references: [id])

  @@unique([groupId, studentId])
  @@index([tenantId, studentId])
}

model Subject {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  color     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lessons             Lesson[]
  requirements        LessonRequirement[]
  occurrences         Occurrence[]
  exams               Exam[]
  planningConstraints PlanningConstraint[]
  teachers            TeacherSubject[]
  assessments         Assessment[]
  gradeWeightings     GradeWeighting[]

  @@unique([tenantId, code])
}

/// Fächer, die eine Lehrkraft unterrichten kann (Lehrbefähigung); Grundlage für Lehrfächerverteilung und Supplierung.
model TeacherSubject {
  tenantId  String
  teacherId String
  subjectId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  teacher Person  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([tenantId, subjectId])
}

model Room {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  capacity  Int?
  kind      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lessons       Lesson[]
  occurrences   Occurrence[]
  substitutions Substitution[]

  @@unique([tenantId, name])
}

model Period {
  id           String   @id @default(cuid())
  tenantId     String
  number       Int
  startTime    String // "08:00" lokal
  endTime      String // "08:50"
  blocksDouble Boolean  @default(false) // Doppelstunde über diese Grenze nicht erlaubt
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, number])
}

// ───────────────────────── Stundenplan ─────────────────────────

model TimetableVersion {
  id            String          @id @default(cuid())
  tenantId      String
  schoolYearId  String
  name          String? // Bezeichnung des Entwurfs, z. B. "Ab Semesterbeginn"
  status        TimetableStatus @default(DRAFT)
  validFrom     DateTime        @db.Date
  publishedAt   DateTime?       @db.Timestamptz(3)
  publishedById String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  schoolYear   SchoolYear          @relation(fields: [schoolYearId], references: [id])
  lessons      Lesson[]
  requirements LessonRequirement[]

  @@index([tenantId, schoolYearId, status])
}

model Lesson {
  id          String      @id @default(cuid())
  tenantId    String
  versionId   String
  subjectId   String
  classId     String? // genau eines von classId oder groupId
  groupId     String?
  roomId      String?
  weekday     Int // 1 = Montag bis 5 = Freitag
  periodStart Int
  periodCount Int         @default(1) // 2 = Doppelstunde
  weekPattern WeekPattern @default(EVERY)
  pinned      Boolean     @default(false) // Teilplanung (M7): bleibt bei einem Lauf des Assistenten unverändert
  version     Int         @default(1) // optimistische Sperre im Editor
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  timetable   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id])
  class       SchoolClass?     @relation(fields: [classId], references: [id])
  group       Group?           @relation(fields: [groupId], references: [id])
  room        Room?            @relation(fields: [roomId], references: [id])
  teachers    LessonTeacher[]
  occurrences Occurrence[]

  @@index([tenantId, versionId, weekday, periodStart])
  @@index([tenantId, classId])
  @@index([tenantId, roomId])
}

model LessonTeacher {
  lessonId  String
  teacherId String
  tenantId  String

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher Person @relation(fields: [teacherId], references: [id])

  @@id([lessonId, teacherId])
  @@index([tenantId, teacherId])
}

model LessonRequirement {
  id           String   @id @default(cuid())
  tenantId     String
  versionId    String
  subjectId    String
  classId      String?
  groupId      String?
  teacherId    String
  hoursPerWeek Int
  preferDouble Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  timetable TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subject   Subject          @relation(fields: [subjectId], references: [id])
  class     SchoolClass?     @relation(fields: [classId], references: [id])
  group     Group?           @relation(fields: [groupId], references: [id])
  teacher   Person           @relation(fields: [teacherId], references: [id])

  @@index([tenantId, versionId])
}

model Occurrence {
  id          String           @id @default(cuid())
  tenantId    String
  lessonId    String?
  date        DateTime         @db.Date
  periodStart Int
  periodCount Int
  startsAt    DateTime         @db.Timestamptz(3)
  endsAt      DateTime         @db.Timestamptz(3)
  classId     String?
  groupId     String?
  subjectId   String
  roomId      String? // wirksamer Raum nach Änderungen
  status      OccurrenceStatus @default(SCHEDULED)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  lesson       Lesson?             @relation(fields: [lessonId], references: [id])
  class        SchoolClass?        @relation(fields: [classId], references: [id])
  group        Group?              @relation(fields: [groupId], references: [id])
  subject      Subject             @relation(fields: [subjectId], references: [id])
  room         Room?               @relation(fields: [roomId], references: [id])
  teachers     OccurrenceTeacher[] // wirksame Lehrer nach Supplierung
  classbook    ClassbookEntry?
  remarks      ClassbookRemark[]
  attendances  Attendance[]
  substitution Substitution?

  @@unique([lessonId, date])
  @@index([tenantId, date])
  @@index([tenantId, classId, date])
}

model OccurrenceTeacher {
  occurrenceId String
  teacherId    String
  tenantId     String

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  teacher    Person     @relation(fields: [teacherId], references: [id])

  @@id([occurrenceId, teacherId])
  @@index([tenantId, teacherId])
}

// ───────────────────────── Klassenbuch, Anwesenheit ─────────────────────────

model ClassbookEntry {
  id             String    @id @default(cuid())
  tenantId       String
  occurrenceId   String    @unique
  topic          String?
  homework       String?
  homeworkDueOn  DateTime? @db.Date
  note           String? // nur Lehrer und Klassenvorstand
  closedAt       DateTime? @db.Timestamptz(3)
  closedById     String?
  version        Int       @default(1) // optimistische Sperre
  updatedById    String? // zuletzt bearbeitet von (Person)
  lastMutationId String? // Idempotenz: clientMutationId der letzten angewandten Änderung (Offline-Outbox)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id])

  @@index([tenantId, closedAt])
}

/// Besondere Vorkommnisse (KB-07): Vermerk zu einer Schülerin oder einem Schüler in einer Stunde. Sichtbar nur für
/// Lehrkräfte der Stunde, Klassenvorstand und Direktion; nie für Schüler:innen und Eltern.
model ClassbookRemark {
  id               String   @id @default(cuid())
  tenantId         String
  occurrenceId     String
  studentId        String
  text             String
  createdById      String
  clientMutationId String? // Idempotenz bei Offline-Sync
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id])
  student    Person     @relation("RemarkStudent", fields: [studentId], references: [id])
  createdBy  Person     @relation("RemarkAuthor", fields: [createdById], references: [id])

  @@unique([tenantId, clientMutationId])
  @@index([tenantId, studentId])
  @@index([tenantId, occurrenceId])
  @@index([tenantId, createdAt])
}

model Attendance {
  id               String           @id @default(cuid())
  tenantId         String
  occurrenceId     String
  studentId        String
  status           AttendanceStatus @default(PRESENT)
  lateMinutes      Int?
  recordedById     String
  clientMutationId String? // Idempotenz bei Offline-Sync
  clientUpdatedAt  DateTime?        @db.Timestamptz(3) // Zeitstempel des Geräts: "letzte Änderung gewinnt"
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id])
  student    Person     @relation(fields: [studentId], references: [id])

  @@unique([occurrenceId, studentId])
  @@unique([tenantId, clientMutationId])
  @@index([tenantId, studentId])
}

// ───────────────────────── Abwesenheit, Supplierung ─────────────────────────

model Absence {
  id             String        @id @default(cuid())
  tenantId       String
  studentId      String
  fromAt         DateTime      @db.Timestamptz(3)
  toAt           DateTime      @db.Timestamptz(3)
  reason         String?
  reasonCode     String? // Krankheit, Arzttermin, Familie, Sonstiges
  origin         AbsenceOrigin @default(REPORT)
  status         AbsenceStatus @default(REPORTED)
  remindersSent  Int           @default(0)
  lastReminderAt DateTime?     @db.Timestamptz(3)
  reportedById   String
  reviewedById   String?
  reviewedAt     DateTime?     @db.Timestamptz(3)
  reviewComment  String?
  attachmentId   String? // FileAsset
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  student    Person     @relation(fields: [studentId], references: [id])
  attachment FileAsset? @relation(fields: [attachmentId], references: [id])

  @@index([tenantId, studentId, fromAt])
  @@index([tenantId, status])
}

enum AbsenceWarningKind {
  UNEXCUSED
  FREQUENT
}

/// Frühwarnung (AB-05): wann der Klassenvorstand zuletzt gewarnt wurde, damit dieselbe Warnung nicht täglich kommt.
model AbsenceWarning {
  id           String             @id @default(cuid())
  tenantId     String
  studentId    String
  schoolYearId String
  kind         AbsenceWarningKind
  notifiedAt   DateTime           @db.Timestamptz(3)

  student    Person     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYearId, kind])
  @@index([tenantId, schoolYearId])
}

model TeacherAbsence {
  id           String             @id @default(cuid())
  tenantId     String
  teacherId    String
  fromAt       DateTime           @db.Timestamptz(3)
  toAt         DateTime           @db.Timestamptz(3)
  kind         TeacherAbsenceKind
  note         String?
  createdById  String?
  approvedById String?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  teacher       Person         @relation(fields: [teacherId], references: [id])
  substitutions Substitution[]

  @@index([tenantId, teacherId, fromAt])
}

model Substitution {
  id                  String             @id @default(cuid())
  tenantId            String
  occurrenceId        String             @unique
  kind                SubstitutionKind
  substituteTeacherId String?
  newRoomId           String?
  note                String?
  status              SubstitutionStatus @default(OPEN)
  teacherAbsenceId    String? // entstanden aus einer Lehrerabwesenheit (für Neuberechnung bei Änderung)
  publishedAt         DateTime?          @db.Timestamptz(3)
  publishedById       String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  occurrence        Occurrence      @relation(fields: [occurrenceId], references: [id])
  substituteTeacher Person?         @relation(fields: [substituteTeacherId], references: [id])
  newRoom           Room?           @relation(fields: [newRoomId], references: [id])
  teacherAbsence    TeacherAbsence? @relation(fields: [teacherAbsenceId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model Exam {
  id          String   @id @default(cuid())
  tenantId    String
  classId     String?
  groupId     String?
  subjectId   String
  date        DateTime @db.Date
  title       String
  kind        String // Schularbeit, Test, Mündlich
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  class      SchoolClass? @relation(fields: [classId], references: [id])
  group      Group?       @relation(fields: [groupId], references: [id])
  subject    Subject      @relation(fields: [subjectId], references: [id])
  assessment Assessment?

  @@index([tenantId, date])
  @@index([tenantId, classId, date])
}

// ───────────────────────── Noten (PN-02, ADR 0018) ─────────────────────────

enum AssessmentKind {
  SCHULARBEIT
  TEST
  MUENDLICH
  MITARBEIT
}

/// Gewichtung in Prozent je Notenart für ein Fach in einer Klasse oder Gruppe (courseKey = "<klasse|gruppe>:<fach>").
model GradeWeighting {
  id           String   @id @default(cuid())
  tenantId     String
  schoolYearId String
  courseKey    String
  subjectId    String
  classId      String?
  groupId      String?
  weights      Json // { SCHULARBEIT: 50, TEST: 25, MUENDLICH: 10, MITARBEIT: 15 }
  updatedById  String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  schoolYear SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id])
  class      SchoolClass? @relation(fields: [classId], references: [id])
  group      Group?       @relation(fields: [groupId], references: [id])

  @@unique([schoolYearId, courseKey])
  @@index([tenantId, schoolYearId])
}

/// Eine Leistungsfeststellung (Schularbeit, Test, mündlich, Mitarbeit) mit Noten; sichtbar ab releasedAt.
model Assessment {
  id           String         @id @default(cuid())
  tenantId     String
  schoolYearId String
  courseKey    String
  subjectId    String
  classId      String?
  groupId      String?
  kind         AssessmentKind
  title        String
  date         DateTime       @db.Date
  examId       String?        @unique
  releasedAt   DateTime?      @db.Timestamptz(3)
  createdById  String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  schoolYear SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id])
  class      SchoolClass? @relation(fields: [classId], references: [id])
  group      Group?       @relation(fields: [groupId], references: [id])
  exam       Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  grades     Grade[]

  @@index([tenantId, schoolYearId, courseKey])
}

model Grade {
  id           String   @id @default(cuid())
  tenantId     String
  assessmentId String
  studentId    String
  value        Int // 1 Sehr gut bis 5 Nicht genügend
  comment      String?
  updatedById  String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Person     @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([tenantId, studentId])
}

// ───────────────────────── Schuljahreswechsel (SD-05, ADR 0019) ─────────────────────────

enum PromotionDecisionKind {
  PROMOTE // steigt auf (letzte Stufe: schließt ab)
  REPEAT // wiederholt die Stufe
  EXAM // Wiederholungsprüfung: steigt vorläufig auf
  LEAVE // verlässt die Schule
}

/// Entscheidung am Ende eines Schuljahres je Schüler:in; ohne Eintrag gilt "steigt auf".
model PromotionDecision {
  id           String                @id @default(cuid())
  tenantId     String
  schoolYearId String // Schuljahr, das endet
  studentId    String
  decision     PromotionDecisionKind
  note         String?
  /// Nur bei EXAM: Ergebnis im neuen Schuljahr (null = offen).
  examPassed   Boolean?
  decidedById  String
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  student    Person     @relation(fields: [studentId], references: [id])

  @@unique([schoolYearId, studentId])
  @@index([tenantId, schoolYearId])
}

// ───────────────────────── Kommunikation ─────────────────────────

model Thread {
  id             String   @id @default(cuid())
  tenantId       String
  subject        String
  createdById    String
  aboutStudentId String? // Gespräch mit den Eltern bzw. der Schülerin/dem Schüler über dieses Kind
  classId        String? // Anlass: Nachricht an eine Klasse (je Familie ein eigenes Gespräch)
  lastMessageAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  messages     Message[]
  participants ThreadParticipant[]
  aboutStudent Person?             @relation("ThreadAbout", fields: [aboutStudentId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, lastMessageAt])
}

model Message {
  id        String   @id @default(cuid())
  tenantId  String
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender Person @relation(fields: [senderId], references: [id])

  @@index([tenantId, threadId, createdAt])
  @@index([tenantId, createdAt])
}

model ThreadParticipant {
  threadId   String
  personId   String
  tenantId   String
  lastReadAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id])

  @@id([threadId, personId])
  @@index([tenantId, personId])
}

model Announcement {
  id           String    @id @default(cuid())
  tenantId     String
  title        String
  body         String
  audience     Json // { roles, classIds, groupIds } (Schema in @sp/shared/messages.ts)
  requiresRead Boolean   @default(false)
  createdById  String
  publishedAt  DateTime? @db.Timestamptz(3)
  remindedAt   DateTime? @db.Timestamptz(3) // letzte Erinnerung an fehlende Lesebestätigungen
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  reads     AnnouncementRead[]
  createdBy Person             @relation(fields: [createdById], references: [id])

  @@index([tenantId, publishedAt])
}

/// Eine Zeile je Empfänger:in (Schnappschuss bei Veröffentlichung); readAt leer = noch nicht gelesen.
model AnnouncementRead {
  announcementId String
  personId       String
  tenantId       String
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id])

  @@id([announcementId, personId])
  @@index([tenantId, personId])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  personId  String
  type      String
  payload   Json // { params, url } – Texte entstehen erst bei der Anzeige (keine Namen in Push-Texten)
  readAt    DateTime? @db.Timestamptz(3)
  pushedAt  DateTime? @db.Timestamptz(3) // per Web-Push zugestellt (oder bewusst übersprungen)
  emailedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, personId, createdAt])
  @@index([tenantId, personId, type, pushedAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String
  personId  String
  type      String
  channel   String
  enabled   Boolean
  quietFrom String?
  quietTo   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, type, channel])
  @@index([tenantId, personId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  personId  String
  endpoint  String   @unique
  keys      Json
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])
}

model CalendarToken {
  id        String   @id @default(cuid())
  tenantId  String
  personId  String
  tokenHash String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])
}

model FileAsset {
  id         String    @id @default(cuid())
  tenantId   String
  key        String
  mime       String
  size       Int
  ownerId    String
  scanStatus String    @default("PENDING") // CLEAN, INFECTED, SKIPPED (nur Entwicklung)
  scannedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  absences Absence[]

  @@index([tenantId, ownerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String // z. B. "absence.excuse", "person.read"
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
}

// ───────────────────────── Sitzungen und Zugangsdaten (M1) ─────────────────────────

model Session {
  id                String       @id @default(cuid())
  tenantId          String
  userId            String
  tokenHash         String       @unique // SHA-256 des Cookie-Werts, der Klartext liegt nur im Cookie
  csrfToken         String
  stage             SessionStage @default(ACTIVE)
  userAgent         String?
  lastSeenAt        DateTime     @default(now()) @db.Timestamptz(3)
  absoluteExpiresAt DateTime     @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  personId    String
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

/// Einladungscode für Eltern: verknüpft ein Elternteil beim Einlösen mit genau einem Kind (SD-04).
/// Der Klartext-Code steht nur im Elternbrief, in der Datenbank nur der Hash.
model GuardianCode {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  codeHash    String   @unique
  maxUses     Int      @default(2) // meist zwei Erziehungsberechtigte
  uses        Int      @default(0)
  expiresAt   DateTime @db.Timestamptz(3)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  student Person @relation(fields: [studentId], references: [id])

  @@index([tenantId, studentId])
}

enum PrivacyRequestKind {
  ACCESS // Auskunft (Export)
  RECTIFICATION // Berichtigung
  ERASURE // Löschung (= Anonymisierung)
  RESTRICTION // Einschränkung der Verarbeitung
}

enum PrivacyRequestStatus {
  OPEN
  DONE
  REJECTED
}

/// Datenschutz-Anfragen (Betroffenenrechte), bearbeitet von der Administration unter /admin/datenschutz.
model PrivacyRequest {
  id           String               @id @default(cuid())
  tenantId     String
  personId     String
  kind         PrivacyRequestKind
  status       PrivacyRequestStatus @default(OPEN)
  note         String?
  createdById  String
  resolvedById String?
  resolvedAt   DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  person Person @relation("PrivacySubject", fields: [personId], references: [id])

  @@index([tenantId, status, createdAt])
}

/// Einwilligungen und Kenntnisnahmen mit Zeitstempel und Version des Textes (Spec Abschnitt 13).
model Consent {
  id         String   @id @default(cuid())
  tenantId   String
  personId   String
  kind       String // z. B. "privacy-notice"
  version    String
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, kind, version])
  @@index([tenantId, personId])
}

// ───────────────────────── Stundenplan-Assistent (M7, ADR 0012) ─────────────────────────

enum PlanningConstraintKind {
  TEACHER_UNAVAILABLE
  TEACHER_MAX_PER_DAY
  CLASS_MAX_PER_DAY
  SUBJECT_ROOMS
  CLASS_HOME_ROOM
  SUBJECT_NOT_PERIODS
  NO_STUDENT_GAPS
}

enum PlanningSource {
  FORM
  TEXT
  AI
}

enum PlanningRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Planungswunsch je Schuljahr (Sperrzeiten, freie Tage, Fachräume, Höchststunden …); hart oder weich.
model PlanningConstraint {
  id           String                 @id @default(cuid())
  tenantId     String
  schoolYearId String
  kind         PlanningConstraintKind
  hard         Boolean                @default(true)
  active       Boolean                @default(true)
  teacherId    String?
  classId      String?
  subjectId    String?
  roomIds      String[]
  weekday      Int?
  periods      Int[]
  max          Int?
  source       PlanningSource         @default(FORM)
  text         String? // ursprünglicher Satz bei Wünschen in Worten
  createdById  String
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)

  schoolYear SchoolYear   @relation(fields: [schoolYearId], references: [id])
  teacher    Person?      @relation(fields: [teacherId], references: [id])
  class      SchoolClass? @relation(fields: [classId], references: [id])
  subject    Subject?     @relation(fields: [subjectId], references: [id])

  @@index([tenantId, schoolYearId])
}

/// Ein Lauf des Solvers: Startwert, Umfang, Ergebnis-Entwurf, Kennzahlen und nicht einplanbare Stunden.
model PlanningRun {
  id              String            @id @default(cuid())
  tenantId        String
  schoolYearId    String
  sourceVersionId String? // Grundlage: feste Stunden (gepinnt oder außerhalb des Umfangs) und Soll-Stunden
  resultVersionId String? // neuer Entwurf
  status          PlanningRunStatus @default(QUEUED)
  scope           Json // { kind: "all" } | { kind: "classes", ids } | { kind: "teachers", ids }
  seed            Int
  stats           Json?
  unplaced        Json?
  error           String?
  createdById     String
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  startedAt       DateTime?         @db.Timestamptz(3)
  finishedAt      DateTime?         @db.Timestamptz(3)

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  @@index([tenantId, schoolYearId, createdAt])
}
