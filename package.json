{
  "name": "schulplattform",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sp/db generate",
    "db:migrate": "pnpm --filter @sp/db migrate",
    "db:seed": "pnpm --filter @sp/shared build && pnpm --filter @sp/db seed",
    "db:reset": "pnpm --filter @sp/db reset",
    "format": "prettier --write .",
    "db:setup-app-role": "pnpm --filter @sp/db setup-app-role",
    "tenant:create": "pnpm --filter @sp/shared build >/dev/null && pnpm --filter @sp/db tenant:create",
    "e2e": "pnpm --filter @sp/web e2e",
    "design:gen": "node scripts/gen-theme.mjs",
    "design:check": "node scripts/gen-theme.mjs --check",
    "design:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
